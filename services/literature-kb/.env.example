# Copy this file to .env on the server. Do not commit the copied file.
# Use URL-safe values for POSTGRES_PASSWORD, e.g. `openssl rand -hex 32`.
POSTGRES_DB=literature_kb
POSTGRES_USER=literature
POSTGRES_PASSWORD=replace-with-a-long-random-value

API_AUTH_TOKEN=replace-with-a-long-random-value
ADMIN_API_TOKEN=replace-with-a-different-long-random-value
MOLYTE_API_TOKEN=replace-with-a-molyte-service-token
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ADMIN_SECRETS_MASTER_KEY=replace-with-a-fernet-key

MAX_UPLOAD_BYTES=52428800
# Host directory for external PDF staging. Production may point this to a
# separately mounted large disk, for example /mnt/T7-Data/literature-kb/downloads.
DISCOVERY_DOWNLOAD_HOST_PATH=./storage/downloads
DISCOVERY_STORAGE_PROVIDER=local
EMBEDDING_DIMENSION=1024
EMBEDDING_MAX_INPUT_CHARS=12000
EMBEDDING_BATCH_MAX_CHARS=24000
RERANK_ENABLED=false
PIPELINE_ENABLED=false

# OpenAlex corpus harvest. Enable PIPELINE_ENABLED before importing staged PDFs.
HARVEST_ENABLED=false
HARVEST_EXPAND_BUFFER_ITEMS=500
HARVEST_DISPATCH_INTERVAL_SECONDS=10
HARVEST_MAX_ATTEMPTS=3
HARVEST_CLI_ENABLED=true
HARVEST_CLI_WORKERS=20

# Configure model provider channels in the Admin page after the first start.
MINERU_API_TOKEN=
MINERU_BASE_URL=https://mineru.net
