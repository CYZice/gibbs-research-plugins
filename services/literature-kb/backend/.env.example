# 本文件只放示例值，不保存真实密钥。
API_AUTH_TOKEN=
ADMIN_API_TOKEN=
ADMIN_SECRETS_MASTER_KEY=
BATCH_ACTIVE_WINDOW=10
TASK_ORPHAN_GRACE_SECONDS=300
PROVIDER_EVENT_RETENTION_DAYS=30
MAX_UPLOAD_BYTES=52428800

DATABASE_URL=postgresql+psycopg://literature:literature@localhost:5432/literature_kb
REDIS_URL=redis://localhost:6379/0
STORAGE_ROOT=../storage
DISCOVERY_DOWNLOAD_ROOT=../storage/downloads
DISCOVERY_STORAGE_PROVIDER=local
DISCOVERY_MAX_DOWNLOAD_BYTES=52428800
DISCOVERY_REQUEST_TIMEOUT_SECONDS=30
DISCOVERY_SEARCH_TIMEOUT_SECONDS=8
DISCOVERY_CACHE_FRESH_SECONDS=300
DISCOVERY_CACHE_STALE_SECONDS=86400
LITERATURE_SEARCH_SESSION_SECONDS=900
DISCOVERY_ALLOW_FAKE_IP_DNS=false
DISCOVERY_CONTACT_EMAIL=
OPENALEX_API_KEY=
CORE_API_KEY=
UNPAYWALL_EMAIL=

# Tencent COS is only used when DISCOVERY_STORAGE_PROVIDER=cos.
COS_BUCKET=gibbs-papers-1234567890
COS_REGION=ap-shanghai
COS_ENDPOINT=example-1234567890.cos.ap-shanghai.myqcloud.com
COS_SECRET_ID=
COS_SECRET_KEY=
COS_PREFIX=literature-kb

APP_ENV=development

EMBEDDING_PROVIDER=dashscope
EMBEDDING_BASE_URL=https://your-compatible-api.example/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_INPUT_CHARS=12000
EMBEDDING_BATCH_MAX_CHARS=24000
EMBEDDING_TIMEOUT_SECONDS=60
PAPER_SEARCH_SEMANTIC_TIMEOUT_SECONDS=1
MODEL_RETRY_MAX_ATTEMPTS=3
WORKFLOW_JOB_TIMEOUT_SECONDS=900
INGEST_JOB_TIMEOUT_SECONDS=7200
PIPELINE_ENABLED=false
HARVEST_ENABLED=false
HARVEST_EXPAND_BUFFER_ITEMS=500
HARVEST_DISPATCH_INTERVAL_SECONDS=10
HARVEST_MAX_ATTEMPTS=3
HARVEST_CLI_ENABLED=true
HARVEST_CLI_WORKERS=20
HARVEST_ALLOW_OPENALEX_CONTENT=false
PIPELINE_EXPAND_CHUNK_SIZE=500
PIPELINE_DISPATCH_INTERVAL_SECONDS=2
PIPELINE_DELIVERY_LEASE_SECONDS=60
PIPELINE_REDIS_BUFFER_MULTIPLIER=3
PIPELINE_OVERDUE_SECONDS=900

STRUCTURED_PROVIDER=dashscope
STRUCTURED_BASE_URL=https://your-compatible-api.example/v1
STRUCTURED_MODEL=qwen3.7-plus
STRUCTURED_TIMEOUT_SECONDS=180
STRUCTURED_STREAM=true

LLM_PROVIDER=dashscope
LLM_BASE_URL=https://your-compatible-api.example/v1
LLM_MODEL=qwen3.7-plus
LLM_TIMEOUT_SECONDS=180
LLM_STREAM=true

VISION_PROVIDER=dashscope
VISION_BASE_URL=https://your-compatible-api.example/v1
VISION_MODEL=gemini-3.5-flash

RERANK_PROVIDER=dashscope
# For qwen3-rerank, set this to the workspace/region base ending in /compatible-mode/v1.
RERANK_BASE_URL=https://your-compatible-api.example/v1
RERANK_MODEL=qwen3-rerank
RERANK_ENABLED=true
RERANK_TIMEOUT_SECONDS=60

MINERU_API_TOKEN=
MINERU_BASE_URL=https://mineru.net
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=ch
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=true
MINERU_IS_OCR=false
